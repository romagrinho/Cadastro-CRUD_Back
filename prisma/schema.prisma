generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// 2. O Modelo de Usuário adaptado
model User {
  // No SQL Server, não usamos @db.ObjectId.
  // Usamos String com UUID (gera um código único) para ficar parecido com o do vídeo
  // OU usamos Int com autoincrement() se quiser IDs numéricos (1, 2, 3).
  // Vou deixar como String para bater com o tipo que o instrutor deve usar no JS.
  id      Int @id @default(autoincrement())
  
  email   String @unique
  name    String?
  
  // AVISO: O campo 'address' no vídeo provavelmente é um tipo composto (Embedded).
  // No SQL Server, isso não funciona igual.
  // Por enquanto, vou comentar para não dar erro. Se ele usar no vídeo,
  // teremos que criar uma tabela 'Address' separada depois.
  // address Address? 

  // Relacionamento com Posts (igual ao vídeo)
  posts   Post[]
}

// Se ele criou um model Post no vídeo, seria algo assim para SQL Server:
model Post {
  id        Int  @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  
  // A ligação com o usuário (Chave Estrangeira)
  authorId  Int
  author    User    @relation(fields: [authorId], references: [id])
}